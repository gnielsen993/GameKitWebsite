DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

<FilesMatch "\.(html|css|js|xml|txt)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(png|jpg|svg|ico)$">
  Header set Cache-Control "public, max-age=86400, must-revalidate"
</FilesMatch>
